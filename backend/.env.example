# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://localhost:27017/one_blood_connect

# Port the Express server listens on
PORT=3000

# Path to your Firebase Admin SDK service account JSON key file
# Download from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# For hosting providers, set FIREBASE_SERVICE_ACCOUNT_JSON to the full JSON
# contents of the same service-account key instead of uploading a local file.
